# 로컬 개발용 설정. 이 파일을 .dev.vars로 복사해서 쓰세요. (.dev.vars는 git에 올라가지 않습니다)
# wrangler dev는 .dev.vars 값으로 wrangler.jsonc의 vars를 덮어씁니다.

# Claude API 키 (console.anthropic.com). MOCK_ANALYSIS=true면 없어도 됩니다.
ANTHROPIC_API_KEY=sk-ant-...

# dev 모드: Firebase 없이 X-Dev-Key 헤더로 인증
AUTH_MODE=dev
DEV_KEY=change-me-to-a-long-random-string

# true면 Claude를 호출하지 않고 간단한 규칙으로 가짜 결과를 돌려줍니다 (앱 UI 개발용, 비용 0)
MOCK_ANALYSIS=true
